{
  "entry_function": {
    "name": "Solana Token Entry Bot",
    "description": "Monitors new pools and executes buys for promising tokens",
    "runtime": "nodejs16",
    "handler": "entry_function.main",
    "triggers": [
      {
        "type": "stream",
        "description": "New pool creation events",
        "filter": {
          "programId": "675kPX9MHTjS2zt1qfr1NYHuzeLXfQM9H24wFSUt1Mp8",
          "type": "log",
          "mentions": ["PoolCreated", "InitializePool"]
        }
      },
      {
        "type": "webhook",
        "description": "Manual trigger for testing",
        "path": "/entry"
      }
    ],
    "environment": {
      "WALLET_ADDRESS": "YOUR_WALLET_ADDRESS",
      "MIN_LIQUIDITY_THRESHOLD": "100000",
      "MAX_TOKEN_AGE": "82800",
      "SLIPPAGE_BPS": "100"
    }
  },
  "exit_function": {
    "name": "Solana Token Exit Bot",
    "description": "Monitors positions and executes stop-loss when needed",
    "runtime": "nodejs16",
    "handler": "exit_function.main",
    "triggers": [
      {
        "type": "alert",
        "description": "Chainlink price feed updates",
        "condition": {
          "type": "log",
          "address": "CHAINLINK_AGGREGATOR_ADDRESS",
          "topic0": "0x0559884fd3a460db3073b7fc896cc77986f16e378210ded43186175bf646fc5f"
        }
      },
      {
        "type": "scheduled",
        "description": "Periodic position monitoring",
        "schedule": "*/5 * * * *"
      }
    ],
    "environment": {
      "WALLET_ADDRESS": "YOUR_WALLET_ADDRESS",
      "STOP_LOSS_PERCENTAGE": "10",
      "SLIPPAGE_BPS": "500"
    }
  }
} 