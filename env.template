# Environment Template for Candlestick Nano Trading Bot
# Copy this file to config/.envrc and fill in your actual values

# =============================================================================
# SOLANA CONFIGURATION
# =============================================================================
# Your Solana wallet private key (base58 encoded)
SOLANA_PRIVATE_KEY=your_private_key_here

# Solana RPC endpoint (QuickNode or other provider)
SOLANA_RPC_URL=https://your-quicknode-endpoint.solana-mainnet.quiknode.pro/your-token/

# Solana network: mainnet-beta, devnet, or testnet
SOLANA_NETWORK=devnet

# =============================================================================
# QUICKNODE METIS CONFIGURATION  
# =============================================================================
# QuickNode Metis API endpoint for market analysis
QUICKNODE_METIS_ENDPOINT=https://your-metis-endpoint.com

# QuickNode Metis API key
QUICKNODE_METIS_API_KEY=your_metis_api_key

# =============================================================================
# TRADING CONFIGURATION
# =============================================================================
# Maximum trade size in SOL
MAX_TRADE_SIZE_SOL=0.1

# Default slippage tolerance (percentage)
DEFAULT_SLIPPAGE=1.0

# Trading mode: live or paper
TRADING_MODE=paper

# =============================================================================
# CLAUDE AI CONFIGURATION
# =============================================================================
# Your Anthropic API key for Claude Code CLI integration
# Get this from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-your-api-key-here

# =============================================================================
# AWS CONFIGURATION (for deployment)
# =============================================================================
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
LOG_LEVEL=INFO
LOG_FILE_PATH=./logs/trading_bot.log

# =============================================================================
# DATABASE CONFIGURATION (if using)
# =============================================================================
# DATABASE_URL=postgresql://user:password@localhost:5432/candlestick_nano

# =============================================================================
# MONITORING CONFIGURATION
# =============================================================================
# Enable performance monitoring
ENABLE_MONITORING=true

# Monitoring interval in seconds
MONITORING_INTERVAL=60 